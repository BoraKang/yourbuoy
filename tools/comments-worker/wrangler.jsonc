{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourbuoy-comments",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // 댓글 API 주소. 본 사이트(yourbuoy.kr apex)는 건드리지 않는다.
  "routes": [
    { "pattern": "comments.yourbuoy.kr", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yourbuoy-comments",
      "database_id": "635cc927-2dfb-42c5-9e3f-7ddfa118fcdb"
    }
  ],

  "vars": {
    // CORS 허용 출처. 첫 번째가 기본값이다.
    "ALLOWED_ORIGINS": "https://yourbuoy.kr,https://www.yourbuoy.kr,http://localhost:4000,http://127.0.0.1:4000",
    // "1"로 바꾸면 승인 전까지 댓글이 공개되지 않는다.
    "REQUIRE_APPROVAL": "0"
  }

  // 시크릿(ADMIN_TOKEN, IP_SALT)은 여기 두지 않는다.
  // npx wrangler secret put ADMIN_TOKEN / IP_SALT 로 넣는다.
}
